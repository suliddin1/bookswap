{
  "name": "bookswap",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <25"
  },
  "overrides": {
    "brace-expansion@1.1.15": "1.1.16",
    "brace-expansion@5.0.6": "5.0.8",
    "js-yaml": "4.3.0",
    "next": {
      "sharp": "0.35.3"
    },
    "postcss": "8.5.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit --strict",
    "test": "vitest run tests/api.test.ts tests/rate-limit.test.ts tests/site-security.test.ts --root .",
    "test:env": "node scripts/validate-development-env.mjs",
    "test:authorization": "node scripts/run-authorization-tests.mjs",
    "test:database:static": "node scripts/check-migrations.mjs",
    "test:production-rehearsal": "node scripts/check-production-rehearsal.mjs",
    "test:dependencies": "node scripts/check-dependency-security.mjs",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:performance": "node scripts/check-performance-budgets.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.39.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "next": "15.5.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "0.35.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.18",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  }
}
